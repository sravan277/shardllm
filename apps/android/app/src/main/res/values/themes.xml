<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LAN-signal theme (Compose draws the UI; this covers the Activity window/splash). -->
    <style name="Theme.DllmMesh" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/panel</item>
    </style>
</resources>
